{
  "name": "mta-playground",
  "version": "1.0.0",
  "description": "A toy MTA that takes email delivery seriously",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "vitest run",
    "api": "tsx src/api/index.ts",
    "mta": "tsx src/mta/index.ts",
    "gmail": "tsx src/providers/fake-gmail.ts",
    "dev": "concurrently -n api,mta,gmail -c blue,green,yellow \"npm:api\" \"npm:mta\" \"npm:gmail\""
  },
  "keywords": [],
  "author": "Rubens Shoji",
  "license": "MIT",
  "packageManager": "pnpm@11.12.0",
  "type": "module",
  "dependencies": {
    "@hono/node-server": "2.0.11",
    "amqplib": "2.0.1",
    "hono": "4.12.32",
    "nodemailer": "9.0.3",
    "smtp-server": "3.19.2"
  },
  "devDependencies": {
    "@types/amqplib": "0.10.8",
    "@types/node": "26.1.1",
    "@types/nodemailer": "8.0.1",
    "@types/smtp-server": "3.5.13",
    "concurrently": "10.0.3",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
