{
  "name": "mta-playground",
  "version": "1.0.0",
  "description": "A toy MTA that takes email delivery seriously",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "vitest run",
    "api": "tsx --env-file=.env src/api/index.ts",
    "mta": "tsx --env-file=.env src/mta/index.ts",
    "writer": "tsx --env-file=.env src/writer/index.ts",
    "gmail": "tsx --env-file=.env src/providers/fake-gmail.ts",
    "outlook": "tsx --env-file=.env src/providers/fake-outlook.ts",
    "yahoo": "tsx --env-file=.env src/providers/fake-yahoo.ts",
    "dev": "concurrently -n api,mta,writer,gmail,outlook,yahoo -c blue,green,red,yellow,magenta,cyan \"npm:api\" \"npm:mta\" \"npm:writer\" \"npm:gmail\" \"npm:outlook\" \"npm:yahoo\"",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "Rubens Shoji",
  "license": "MIT",
  "packageManager": "pnpm@11.12.0",
  "type": "module",
  "dependencies": {
    "@hono/node-server": "2.0.11",
    "amqplib": "2.0.1",
    "drizzle-orm": "^0.45.2",
    "hono": "4.12.32",
    "nodemailer": "9.0.3",
    "pg": "^8.22.0",
    "smtp-server": "3.19.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/amqplib": "0.10.8",
    "@types/node": "26.1.1",
    "@types/nodemailer": "8.0.1",
    "@types/pg": "^8.20.0",
    "@types/smtp-server": "3.5.13",
    "concurrently": "10.0.3",
    "drizzle-kit": "^0.31.10",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
